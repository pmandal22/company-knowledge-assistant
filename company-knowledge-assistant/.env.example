# Postgres connection string (async SQLAlchemy/psycopg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/postgres

# OpenAI API key for LLM/embeddings
OPENAI_API_KEY=your-openai-api-key

# LangSmith tracing (optional)
export LANGSMITH_TRACING=true
export LANGSMITH_ENDPOINT=https://api.smith.langchain.com
export LANGSMITH_API_KEY=your-langsmith-api-key
export LANGSMITH_PROJECT="cka"

# Cohere API key (used for reranking)
CO_API_KEY=your-cohere-api-key

# App config
DATA_DIR=data
RETRIEVAL_K=5
REDIS_URL=redis://cka-redis:6379/0
