# Database connection used by the application.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# OpenAI credentials for chat completions and embeddings.
OPENAI_API_KEY=your_openai_api_key

# LangSmith observability. Set LANGSMITH_TRACING=false to disable tracing.
LANGSMITH_TRACING=true
# Use your LangSmith region endpoint, for example:
# https://api.smith.langchain.com or https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=cka

# Cohere key used for document reranking.
CO_API_KEY=your_cohere_api_key

# Application configuration.
DATA_DIR=data
RETRIEVAL_K=5
REDIS_URL=redis://localhost:6379/0
